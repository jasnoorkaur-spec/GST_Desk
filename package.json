{
  "name": "gstdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --watch src/server/index.js",
    "start": "node src/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/server/db/migrate.js",
    "check": "find src public/js -type f -name \"*.js\" -exec node --check {} \\; && node --check drizzle.config.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.2",
    "nodemailer": "^7.0.10",
    "zod": "^4.1.12",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
