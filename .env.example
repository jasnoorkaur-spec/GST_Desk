# Required: DATABASE_URL (mysql://user:pass@host:3306/db) and GST_APP_JWT_SECRET (32+ chars).
# For local plain-HTTP development only, set LOCAL_HTTP_COOKIE=true.
LOCAL_HTTP_COOKIE=true
# Optional SMTP configuration enables reset emails and email-OTP MFA.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Directory for uploaded business logos (mount a persistent volume here in production)
UPLOAD_DIR=./uploads
